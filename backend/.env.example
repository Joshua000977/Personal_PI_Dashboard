# Copy this file to .env and add the real values.

FRONTEND_URL=http://your-frontend-host:5173

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=your_spotify_redirect_uri

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token

# Bambu Lab
# Add every Bambu entity used by the backend.
# Entity IDs are unique to each printer and can be found under:
# Home Assistant -> Developer Tools -> States
BAMBU_ONLINE_ENTITY=replace_me
BAMBU_TASK_NAME_ENTITY=replace_me
BAMBU_PRINTER_NAME_ENTITY=replace_me
BAMBU_WIFI_SIGNAL_ENTITY=replace_me

# GitHub
GITHUB_USERNAME=your_github_username